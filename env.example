# Copy to `.env` or `.env.local` for `next dev`. Add the same keys in Vercel → Project → Settings → Environment Variables (Production / Preview).

# Required for OTP, booking confirmation, contact form, feedback emails (Gmail SMTP — use an App Password, not your normal Gmail password)
EMAIL_USER=your.sender@gmail.com
EMAIL_PASS=your_gmail_app_password

# Server-only Firebase Admin SDK credentials (service account JSON on one line)
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"your-project-id","client_email":"...","private_key":"..."}

# Required server-only OTP HMAC secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=replace_with_a_long_random_secret

# Protects the scheduled booking reminder endpoint. Use a long random value.
CRON_SECRET=replace_with_a_long_random_secret

# reCAPTCHA v2 server-side verification secret (required in production)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Optional aliases (either pair works)
# EMAIL_PASSWORD=same_as_EMAIL_PASS
